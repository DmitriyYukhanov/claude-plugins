#!/bin/bash
# Pre-commit hook: enforce plugin version bumps, marketplace sync, changelog, and new plugin registration
#
# Checks:
# 1. On main/master: when files inside plugins/<name>/ change, plugin.json version must be bumped
# 2. When plugin.json version changes, marketplace.json must match
# 3. On main/master: when plugin.json version changes, CHANGELOG.md must be updated
# 4. When a new plugin directory appears, it must be registered in marketplace.json and README.md
#
# Follows Keep a Changelog / Semantic Versioning conventions.
# To bypass (emergency only): git commit --no-verify

set -euo pipefail

MARKETPLACE=".claude-plugin/marketplace.json"

# CI checks the whole PR against its merge base; local commits still check the index.
old_ref=HEAD new_ref=''
if [ "$#" -eq 0 ]; then
  diff_args=(--cached --no-renames --diff-filter=ACDMRT)
elif [ "$#" -eq 3 ] && [ "$1" = --ci ]; then
  old_ref=$(git merge-base "$2" "$3")
  new_ref=$(git rev-parse --verify "$3^{commit}")
  diff_args=(--no-renames --diff-filter=ACDMRT "$old_ref" "$new_ref")
else
  printf 'usage: pre-commit [--ci BASE HEAD]\n' >&2
  exit 2
fi

staged_files=$(git diff "${diff_args[@]}" --name-only)
if [ -z "$staged_files" ]; then
  exit 0
fi

# Version bumps and changelog entries are release bookkeeping, owed by what lands on main. A
# development branch commits freely and carries its bump before the PR; only a commit made on
# main or master is held to Checks 1 and 3 here.
release_branch=
if [ -n "$new_ref" ]; then
  release_branch=yes
else
  case "$(git symbolic-ref --short -q HEAD || true)" in
    main | master) release_branch=yes ;;
  esac
fi

# Collect unique plugins touched by the candidate snapshot.
changed_plugins=()
while IFS= read -r -d '' file; do
  if [[ "$file" =~ ^plugins/([^/]+)/ ]]; then
    plugin_name="${BASH_REMATCH[1]}"
    # Deduplicate
    if [[ " ${changed_plugins[*]:-} " != *" ${plugin_name} "* ]]; then
      changed_plugins+=("$plugin_name")
    fi
  fi
done < <(git diff "${diff_args[@]}" --name-only -z)

# ── Check 1: plugin.json version bump ──────────────────────────────────

version_errors=()
if [ -n "$release_branch" ] && [ ${#changed_plugins[@]} -gt 0 ]; then
  for plugin in "${changed_plugins[@]}"; do
    plugin_json="plugins/${plugin}/.claude-plugin/plugin.json"

    # A whole-plugin removal is valid; a surviving plugin needs its manifest.
    if ! git show "${new_ref}:${plugin_json}" &>/dev/null; then
      candidate_files=(ls-files)
      [ -z "$new_ref" ] || candidate_files=(ls-tree -r --name-only "$new_ref")
      if [ -n "$(git "${candidate_files[@]}" -- "plugins/$plugin")" ]; then
        printf 'ERROR: Plugin manifest missing: %s still has files\n' "plugins/$plugin/" >&2
        exit 1
      fi
      continue
    fi

    # Check if plugin.json is in the staged files
    if ! echo "$staged_files" | grep -qx "$plugin_json"; then
      version_errors+=("$plugin")
      continue
    fi

    # Check if the version field actually changed
    old_version=$(git show "${old_ref}:${plugin_json}" 2>/dev/null | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | grep -o '[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*' || echo "0.0.0")
    new_version=$(git show "${new_ref}:${plugin_json}" 2>/dev/null | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | grep -o '[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*' || echo "0.0.0")

    IFS=. read -r old_major old_minor old_patch <<<"$old_version"
    IFS=. read -r new_major new_minor new_patch <<<"$new_version"
    if (( 10#$new_major < 10#$old_major ||
          (10#$new_major == 10#$old_major && 10#$new_minor < 10#$old_minor) ||
          (10#$new_major == 10#$old_major && 10#$new_minor == 10#$old_minor && 10#$new_patch <= 10#$old_patch) )); then
      version_errors+=("$plugin")
    fi
  done
fi

# ── Check 2: marketplace.json version sync ─────────────────────────────

# ponytail: keep the existing one-field-per-line format; use a JSON parser if it changes.
marketplace_entry() {
  awk -v name="$1" '
    /"name"/ { found = ($0 ~ "\"" name "\"") }
    found && /"version"|"description"/ { sub(/^[[:space:]]*/, ""); print }
  '
}
sync_errors=()
old_marketplace_content=''
marketplace_content=$(git show "${new_ref}:${MARKETPLACE}" 2>/dev/null || echo "")
plugin_manifests=$(echo "$staged_files" | grep -E '^plugins/[^/]+/\.claude-plugin/plugin\.json$' || true)
if echo "$staged_files" | grep -qx "$MARKETPLACE"; then
  old_marketplace_content=$(git show "${old_ref}:${MARKETPLACE}" 2>/dev/null || echo "")
  candidate_files=(ls-files)
  [ -z "$new_ref" ] || candidate_files=(ls-tree -r --name-only "$new_ref")
  plugin_manifests=$(git "${candidate_files[@]}" -- plugins | grep -E '^plugins/[^/]+/\.claude-plugin/plugin\.json$' || true)
fi
for plugin_json in $plugin_manifests; do
  plugin_name=${plugin_json#plugins/}; plugin_name=${plugin_name%%/*}
  # Unchanged listings do not make this PR responsible for unrelated baseline drift.
  if ! echo "$staged_files" | grep -qx "$plugin_json" && [ -n "$marketplace_content" ] &&
    [ "$(echo "$old_marketplace_content" | marketplace_entry "$plugin_name")" = "$(echo "$marketplace_content" | marketplace_entry "$plugin_name")" ]; then
    continue
  fi

  # Get the new version from staged plugin.json
  plugin_version=$(git show "${new_ref}:${plugin_json}" 2>/dev/null | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | grep -o '[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*' || echo "")

  if [ -z "$plugin_version" ]; then
    continue
  fi

  if [ -z "$marketplace_content" ]; then
    sync_errors+=("${plugin_name}: ${MARKETPLACE} is missing or empty")
    continue
  fi

  marketplace_version=$(echo "$marketplace_content" | awk -v name="$plugin_name" '
    /"name"/ { found = ($0 ~ "\"" name "\"") }
    found && /"version"/ { match($0, /[0-9]+\.[0-9]+\.[0-9]+/); print substr($0, RSTART, RLENGTH); found=0 }
  ')

  if [ -z "$marketplace_version" ]; then
    if echo "$marketplace_content" | grep -q "\"${plugin_name}\""; then
      sync_errors+=("${plugin_name}: entry in ${MARKETPLACE} has no readable version")
    fi
  elif [ "$plugin_version" != "$marketplace_version" ]; then
    sync_errors+=("${plugin_name}: plugin.json=${plugin_version}, marketplace.json=${marketplace_version}")
  fi

  # The description drifts the same way the version does, and for two releases nothing noticed:
  # issue-to-pr corrected one sentence in three places and left plugin.json, the only copy
  # Claude Code itself reads, promising the old behaviour. Same loop, same anchoring.
  plugin_desc=$(git show "${new_ref}:${plugin_json}" 2>/dev/null | awk '
    /"description"/ {
      sub(/^[[:space:]]*"description"[[:space:]]*:[[:space:]]*"/, "")
      sub(/",?$/, "")
      print; exit
    }
  ')

  marketplace_desc=$(echo "$marketplace_content" | awk -v name="$plugin_name" '
    /"name"/ { found = ($0 ~ "\"" name "\"") }
    found && /"description"/ {
      sub(/^[[:space:]]*"description"[[:space:]]*:[[:space:]]*"/, "")
      sub(/",?$/, "")
      print; found=0
    }
  ')

  # Fail closed, because every silent path here is a way for the two files to drift unnoticed.
  # A renamed or deleted entry is the worst of them: it takes the version check above down with
  # it, so a commit can change both fields and report nothing at all. If the version moved, the
  # plugin has to be findable in the marketplace, and both descriptions have to be readable.
  # A brand-new plugin has no entry yet and no HEAD manifest to compare against; Check 4 owns
  # that case and says the right thing about it. Complaining here as well would report a rename
  # of something that never existed.
  # Not `$(git show ... | head -c 1)`: this file runs under `set -euo pipefail`, so pipefail
  # hands the pipeline git's 128 for a path absent from HEAD and the hook dies right here,
  # rejecting every new-plugin commit with no message at all.
  if git show "${old_ref}:${plugin_json}" >/dev/null 2>&1; then
    plugin_existed=yes
  else
    plugin_existed=
  fi

  if [ -n "$plugin_existed" ] && ! echo "$marketplace_content" | grep -q "\"${plugin_name}\""; then
    sync_errors+=("${plugin_name}: no entry in ${MARKETPLACE} (renamed or removed?)")
  elif ! echo "$marketplace_content" | grep -q "\"${plugin_name}\""; then
    : # new plugin, unregistered - Check 4 reports it
  elif [ -z "$plugin_desc" ]; then
    sync_errors+=("${plugin_name}: no description found in ${plugin_json}")
  elif [ -z "$marketplace_desc" ]; then
    sync_errors+=("${plugin_name}: entry in ${MARKETPLACE} has no description")
  elif [ "$plugin_desc" != "$marketplace_desc" ]; then
    sync_errors+=("${plugin_name}: descriptions differ
      plugin.json:      ${plugin_desc}
      marketplace.json: ${marketplace_desc}")
  fi
done

# ── Check 3: CHANGELOG.md updated when version bumps ──────────────────

changelog_errors=()
for plugin_json in $(echo "$staged_files" | grep -E '^plugins/[^/]+/\.claude-plugin/plugin\.json$' || true); do
  [ -n "$release_branch" ] || break
  plugin_name=${plugin_json#plugins/}; plugin_name=${plugin_name%%/*}
  changelog="plugins/${plugin_name}/CHANGELOG.md"

  # Get the new version
  new_version=$(git show "${new_ref}:${plugin_json}" 2>/dev/null | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | grep -o '[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*' || echo "")

  if [ -z "$new_version" ]; then
    continue
  fi

  # Check old version to see if it actually changed (skip for brand-new plugins)
  old_version=$(git show "${old_ref}:${plugin_json}" 2>/dev/null | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | grep -o '[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*' || echo "0.0.0")
  if [ "$old_version" = "$new_version" ]; then
    continue
  fi

  # CHANGELOG.md must be staged
  if ! echo "$staged_files" | grep -qx "$changelog"; then
    changelog_errors+=("${plugin_name} (v${new_version}): CHANGELOG.md not staged")
    continue
  fi

  # CHANGELOG.md must contain the new version number
  changelog_content=$(git show "${new_ref}:${changelog}" 2>/dev/null || echo "")
  if ! echo "$changelog_content" | grep -qE "^## \[${new_version//./[.]}\] - [0-9]{4}-[0-9]{2}-[0-9]{2}"$'\r?$'; then
    changelog_errors+=("${plugin_name} (v${new_version}): CHANGELOG.md missing entry for [${new_version}]")
  fi
done

# ── Check 4: new plugin registration (README + marketplace) ───────────

readme_errors=()
marketplace_missing=()

for plugin in "${changed_plugins[@]}"; do
  plugin_json="plugins/${plugin}/.claude-plugin/plugin.json"

  # Detect NEW plugins: plugin.json is staged AND didn't exist in HEAD
  if echo "$staged_files" | grep -qx "$plugin_json"; then
    if ! git show "${old_ref}:${plugin_json}" &>/dev/null; then
      # This is a brand-new plugin

      # Check marketplace.json has an entry
      if ! echo "$marketplace_content" | grep -q "\"$plugin\""; then
        marketplace_missing+=("$plugin")
      fi

      # Check README.md mentions this plugin
      readme_content=$(git show "${new_ref}:README.md" 2>/dev/null || echo "")
      if ! echo "$readme_content" | grep -q "### $plugin"; then
        readme_errors+=("$plugin")
      fi
    fi
  fi
done

# ── Report errors ──────────────────────────────────────────────────────

# ── Check 5: shellcheck staged plugin scripts (skip gracefully if unavailable) ─
# Lints plugins/*/scripts/*.sh and the extension-less fake-gh test shim. Harness
# files (test_*.sh, assert.sh) are intentionally excluded: they reference vars
# the runner injects, which would trip SC2154. If shellcheck is not installed
# (common on Windows), we skip with a notice - CI enforces it on both OSes.
shellcheck_errors=()
if command -v shellcheck >/dev/null 2>&1; then
  sc_files=()
  while IFS= read -r f; do
    case "$f" in
      plugins/*/scripts/*.sh | plugins/*/tests/fake-gh/gh)
        [ -f "$f" ] && sc_files+=("$f")
        ;;
    esac
  done <<< "$staged_files"
  if [ ${#sc_files[@]} -gt 0 ]; then
    if ! sc_out=$(shellcheck -x -e SC1091 "${sc_files[@]}" 2>&1); then
      shellcheck_errors+=("$sc_out")
    fi
  fi
else
  echo "note: shellcheck not installed - skipping shell-script lint (CI enforces it)" >&2
fi

has_errors=false

if [ ${#version_errors[@]} -gt 0 ]; then
  has_errors=true
  echo ""
  echo "ERROR: Plugin version bump required"
  echo "========================================"
  echo ""
  echo "The following plugins have changed files but no version bump in plugin.json:"
  echo ""
  for plugin in "${version_errors[@]}"; do
    plugin_json="plugins/${plugin}/.claude-plugin/plugin.json"
    current=$(cat "$plugin_json" 2>/dev/null | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | grep -o '[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*' || echo "unknown")
    echo "  - plugins/${plugin}/  (current version: ${current})"
  done
  echo ""
  echo "Versioning guide (Semantic Versioning / Keep a Changelog):"
  echo "  PATCH (x.y.Z) — bug fixes, typo corrections, minor tweaks"
  echo "  MINOR (x.Y.0) — new features, skill improvements, non-breaking changes"
  echo "  MAJOR (X.0.0) — breaking changes, major restructuring"
  echo ""
  echo "Fix: update \"version\" in the plugin's .claude-plugin/plugin.json, then re-stage and commit."
fi

if [ ${#sync_errors[@]} -gt 0 ]; then
  has_errors=true
  echo ""
  echo "ERROR: marketplace.json out of sync"
  echo "========================================"
  echo ""
  echo "These plugins disagree with marketplace.json about their version or their description:"
  echo ""
  for err in "${sync_errors[@]}"; do
    echo "  - ${err}"
  done
  echo ""
  echo "Fix: bring the two files into agreement on the field named above, then re-stage."
  echo "     'descriptions differ' or a version mismatch: edit whichever copy is wrong."
  echo "     'no description found in plugins/...': add the key to that plugin.json."
  echo "     'entry ... has no description': add it to ${MARKETPLACE}."
  echo "     'no entry in ...': the marketplace entry was renamed or deleted. Restore it."
fi

if [ ${#changelog_errors[@]} -gt 0 ]; then
  has_errors=true
  echo ""
  echo "ERROR: CHANGELOG.md update required"
  echo "========================================"
  echo ""
  echo "The following plugins have version bumps but no corresponding CHANGELOG.md entry:"
  echo ""
  for err in "${changelog_errors[@]}"; do
    echo "  - ${err}"
  done
  echo ""
  echo "Fix: add a ## [X.Y.Z] - YYYY-MM-DD section to plugins/<name>/CHANGELOG.md with the changes,"
  echo "     then re-stage and commit."
  echo ""
  echo "Changelog format (Keep a Changelog):"
  echo "  ## [1.2.0] - 2026-04-03"
  echo "  ### Added"
  echo "  - New feature description"
  echo "  ### Fixed"
  echo "  - Bug fix description"
fi

if [ ${#marketplace_missing[@]} -gt 0 ]; then
  has_errors=true
  echo ""
  echo "ERROR: New plugin missing from marketplace.json"
  echo "========================================"
  echo ""
  echo "The following new plugins are not listed in ${MARKETPLACE}:"
  echo ""
  for plugin in "${marketplace_missing[@]}"; do
    echo "  - ${plugin}"
  done
  echo ""
  echo "Fix: add an entry for the plugin in ${MARKETPLACE}, then re-stage and commit."
fi

if [ ${#readme_errors[@]} -gt 0 ]; then
  has_errors=true
  echo ""
  echo "ERROR: New plugin missing from README.md"
  echo "========================================"
  echo ""
  echo "The following new plugins are not documented in README.md:"
  echo ""
  for plugin in "${readme_errors[@]}"; do
    echo "  - ${plugin}"
  done
  echo ""
  echo "Fix: add an install command and a ### <plugin-name> section to README.md, then re-stage and commit."
fi

if [ ${#shellcheck_errors[@]} -gt 0 ]; then
  has_errors=true
  echo ""
  echo "ERROR: shellcheck reported problems"
  echo "========================================"
  echo ""
  for err in "${shellcheck_errors[@]}"; do
    echo "$err"
  done
  echo ""
  echo "Fix: address the shellcheck findings above (or add a justified"
  echo "     # shellcheck disable=SCXXXX directive), then re-stage and commit."
fi

if [ "$has_errors" = true ]; then
  echo ""
  echo "Bypass (emergency only): git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
