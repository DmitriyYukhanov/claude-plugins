#!/usr/bin/env bash
# A stand-in for gh: serves agent-dispatch's calls from fixture files in FAKE_GH_FIX. The real
# --jq projection is ignored; the files hold what it would print. fail-<name> makes a call fail.
set -uo pipefail
F=$FAKE_GH_FIX
printf 'gh %s\n' "$*" >>"$F/gh.log"

value_of() { # flag args... -> the argument after flag
  local want=$1
  shift
  while [ "$#" -gt 0 ]; do
    if [ "$1" = "$want" ]; then
      printf '%s' "${2:-}"
      return
    fi
    shift
  done
}
serve() { # name
  [ -e "$F/fail-$1" ] && exit 1
  cat "$F/$1" 2>/dev/null
  exit 0
}

case "${1:-} ${2:-}" in
  "api user") serve user ;;
  "api graphql") # the body's edit history: totalCount, then `editedAt\teditor` rows, newest first
    n=$(value_of -F "$@")
    serve "graphql-${n#n=}"
    ;;
  "api repos/"*)
    n=${2%/*}
    n=${n##*/}
    case "$2" in
      */comments) serve "comments-$n" ;;
      */events)
        # events-<n> holds `<label>\t<actor>[\t<time>]` rows, plus `renamed\t<actor>\t<time>` for
        # title edits; this prints them as JQ_LABEL_EVENTS would: `event\tlabel\tactor\ttime`.
        [ -e "$F/fail-events-$n" ] && exit 1
        while IFS=$'\t' read -r l a t; do
          if [ "$l" = renamed ]; then
            printf 'renamed\t\t%s\t%s\n' "$a" "${t:-}"
          else
            printf 'labeled\t%s\t%s\t%s\n' "$l" "$a" "${t:-}"
          fi
        done <"$F/events-$n" 2>/dev/null
        ;;
    esac
    ;;
  "repo view") serve repo ;;
  "issue list")
    [ -e "$F/fail-issues" ] && exit 1
    while IFS=$'\t' read -r n labels; do
      [ -n "$n" ] || continue
      if [ -f "$F/labels-$n" ]; then labels=$(paste -sd, "$F/labels-$n"); fi
      case ",$labels," in
        *,agent,* | *,agent:waiting,* | *,agent:review,*) printf '%s\t%s\n' "$n" "$labels" ;;
      esac
    done <"$F/issues" 2>/dev/null
    ;;
  "issue view") serve "labels-$3" ;;
  "issue comment")
    [ -e "$F/fail-comment" ] && exit 1
    body=$(cat "$(value_of --body-file "$@")")
    printf '%s\n' "$body" >>"$F/posted-$3"
    comment_id=$(cat "$F/comment-id" 2>/dev/null || printf '1000')
    comment_id=$((comment_id + 1))
    printf '%s\n' "$comment_id" >"$F/comment-id"
    marker=$(printf '%s\n' "$body" | grep '<!-- issue-to-pr state=' | tail -1)
    printf '%s\t%s\t%s\n' "$comment_id" "$(cat "$F/user")" "$marker" >>"$F/comments-$3"
    ;;
  "issue edit")
    [ -e "$F/fail-edit" ] && exit 1
    add=$(value_of --add-label "$@")
    [ -e "$F/fail-edit-$add" ] && exit 1
    { [ -e "$F/fail-remove-only-$add" ] || printf '%s\n' "$add"; value_of --remove-label "$@" | tr ',' '\n'; } | grep . >"$F/.drop"
    touch "$F/labels-$3"
    { grep -v -x -F -f "$F/.drop" "$F/labels-$3"; [ -e "$F/fail-remove-only-$add" ] || printf '%s\n' "$add"; } | grep . >"$F/.labels"
    mv "$F/.labels" "$F/labels-$3"
    [ -e "$F/fail-remove-only-$add" ] && exit 1
    [ -e "$F/fail-after-edit-$add" ] && exit 1
    ;;
esac
exit 0
