#!/usr/bin/env bash
# A stand-in for gh: serves agent-dispatch's calls from fixture files in FAKE_GH_FIX. The real
# --jq projection is ignored; the files hold what it would print. fail-<name> makes a call fail.
set -uo pipefail
F=$FAKE_GH_FIX
printf 'gh %s\n' "$*" >>"$F/gh.log"

value_of() { # flag args... -> the argument after flag
  local want=$1
  shift
  while [ "$#" -gt 0 ]; do
    if [ "$1" = "$want" ]; then
      printf '%s' "${2:-}"
      return
    fi
    shift
  done
}
serve() { # name
  [ -e "$F/fail-$1" ] && exit 1
  cat "$F/$1" 2>/dev/null
  exit 0
}

case "${1:-} ${2:-}" in
  "api user") serve user ;;
  "api graphql") # the issue's `lastEditedAt\teditor` (a missing file: never edited)
    n=$(value_of -F "$@")
    serve "graphql-${n#n=}"
    ;;
  "api repos/"*)
    n=${2%/*}
    n=${n##*/}
    case "$2" in
      */comments) serve "comments-$n" ;;
      */events)
        # The real --jq projection is ignored elsewhere in this file, but here the query names the
        # label owner_approved() is asking about, so events-<n> can hold every label's history
        # (`<label>\t<actor>[\t<time>]` rows, plus `renamed\t<actor>\t<time>` for title edits) and
        # this prints what the projection would: the queried label's rows and every rename.
        [ -e "$F/fail-events-$n" ] && exit 1
        lbl=$(value_of --jq "$@")
        lbl=${lbl#*'label.name == "'}
        lbl=${lbl%%'"'*}
        while IFS=$'\t' read -r l a t; do
          if [ "$l" = "$lbl" ]; then printf 'labeled\t%s\t%s\n' "$a" "${t:-}"; fi
          if [ "$l" = renamed ]; then printf 'renamed\t%s\t%s\n' "$a" "${t:-}"; fi
        done <"$F/events-$n" 2>/dev/null
        ;;
    esac
    ;;
  "repo view") serve repo ;;
  "issue list") serve issues ;;
  "issue view") serve "labels-$3" ;;
  "issue comment")
    [ -e "$F/fail-comment" ] && exit 1
    cat "$(value_of --body-file "$@")" >>"$F/posted-$3"
    ;;
  "issue edit")
    [ -e "$F/fail-edit" ] && exit 1
    add=$(value_of --add-label "$@")
    { printf '%s\n' "$add"; value_of --remove-label "$@" | tr ',' '\n'; } | grep . >"$F/.drop"
    touch "$F/labels-$3"
    { grep -v -x -F -f "$F/.drop" "$F/labels-$3"; printf '%s\n' "$add"; } | grep . >"$F/.labels"
    mv "$F/.labels" "$F/labels-$3"
    ;;
esac
exit 0
