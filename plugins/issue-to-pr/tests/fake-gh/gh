#!/usr/bin/env bash
# A stand-in for gh: answers the four calls finish.sh makes, shaped by FAKE_GH_SCENARIO.
set -uo pipefail

if [ -n "${FAKE_GH_LOG:-}" ]; then
  printf 'gh %s\n' "$*" >>"$FAKE_GH_LOG"
fi

scenario=${FAKE_GH_SCENARIO:-happy}
SHA="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

case "${1:-} ${2:-}" in
  "repo view")
    case "$scenario" in
      default-branch-unreadable) printf '' ;;
      *) printf 'main\n' ;;
    esac
    ;;
  "pr list") # cleanup: open PRs based on the branch
    case "$scenario" in
      has-dependent-pr) printf '77\n' ;;
      dependents-unreadable) exit 1 ;;
      *) printf '' ;;
    esac
    ;;
  "pr view")
    case "$*" in
      *reviewDecision*) # merge: head sha, review decision, base
        case "$scenario" in
          pr-unreadable) exit 1 ;;
          review-changes-requested) printf '%s\tCHANGES_REQUESTED\tmain\n' "$SHA" ;;
          stacked-base) printf '%s\t\tfeat/issue-5-parent\n' "$SHA" ;;
          *) printf '%s\tAPPROVED\tmain\n' "$SHA" ;;
        esac
        ;;
      *) # cleanup: PR state
        case "$scenario" in
          pr-merged | has-dependent-pr | dependents-unreadable) printf 'MERGED\n' ;;
          *) printf 'OPEN\n' ;;
        esac
        ;;
    esac
    ;;
  "pr merge")
    case "$scenario" in
      protected)
        printf 'Protected branch update failed: required status checks have not passed.\n' >&2
        exit 1
        ;;
      *) exit 0 ;;
    esac
    ;;
  *) exit 0 ;;
esac
