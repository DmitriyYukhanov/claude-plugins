#!/usr/bin/env bash
# A stand-in for gh: answers the calls finish.sh makes, shaped by FAKE_GH_SCENARIO. With
# FAKE_GH_FIX set it also serves the headless reads (user, issue labels, comments) from files there.
set -uo pipefail

if [ -n "${FAKE_GH_LOG:-}" ]; then
  printf 'gh %s\n' "$*" >>"$FAKE_GH_LOG"
fi

scenario=${FAKE_GH_SCENARIO:-happy}
SHA="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

serve() { # fixture [default]: FAKE_GH_FIX/<fixture>, else the default; fail-<fixture> exits 1
  [ -n "${FAKE_GH_FIX:-}" ] || { printf '%s' "${2-}"; exit 0; }
  [ ! -e "$FAKE_GH_FIX/fail-$1" ] || exit 1
  if [ -f "$FAKE_GH_FIX/$1" ]; then cat "$FAKE_GH_FIX/$1"; else printf '%s' "${2-}"; fi
}

case "${1:-} ${2:-}" in
  "repo view")
    case "$scenario" in
      default-branch-unreadable) printf '' ;;
      *) printf 'main\n' ;;
    esac
    ;;
  "pr list") # cleanup: open PRs based on the branch
    case "$scenario" in
      has-dependent-pr) printf '77\n' ;;
      dependents-unreadable) exit 1 ;;
      *) printf '' ;;
    esac
    ;;
  "pr view")
    case "$*" in
      *reviewDecision*) # merge: head sha, review decision, base, PR number
        case "$scenario" in
          pr-unreadable) exit 1 ;;
          review-changes-requested) printf '%s\tCHANGES_REQUESTED\tmain\t12\n' "$SHA" ;;
          stacked-base) printf '%s\t\tfeat/issue-5-parent\t12\n' "$SHA" ;;
          *) printf '%s\tAPPROVED\tmain\t12\n' "$SHA" ;;
        esac
        ;;
      *) # cleanup: PR state
        case "$scenario" in
          pr-merged | has-dependent-pr | dependents-unreadable) printf 'MERGED\n' ;;
          *) printf 'OPEN\n' ;;
        esac
        ;;
    esac
    ;;
  "pr merge")
    case "$scenario" in
      protected)
        printf 'Protected branch update failed: required status checks have not passed.\n' >&2
        exit 1
        ;;
      *) exit 0 ;;
    esac
    ;;
  "api user")
    serve user $'octo\n'
    ;;
  "issue view") # headless: the issue's label names
    serve "labels-${3:-}"
    ;;
  "api repos/"*/comments) # headless: a thread's comments as TSV id, login, marker, body
    n=${2%/comments}
    serve "comments-${n##*/}"
    ;;
  *) exit 0 ;;
esac
