# Ensure shell scripts always use LF line endings
*.sh text eol=lf

# issue-to-pr ships bash scripts that must run under Git Bash on Windows and in
# Linux CI. Force LF on the whole tree, including the extension-less fake-gh
# shim (CRLF is the number-one way these break on the author's own machine).
plugins/issue-to-pr/** text eol=lf
plugins/issue-to-pr/tests/fake-gh/gh text eol=lf

# agent-dispatch ships the same kind of extension-less fixture shims (fake gh, fake claude/codex,
# a fake date and sleep) for the same reason.
plugins/agent-dispatch/** text eol=lf
plugins/agent-dispatch/tests/fixtures/fake-gh/gh text eol=lf
plugins/agent-dispatch/tests/fixtures/fake-cli/claude text eol=lf
plugins/agent-dispatch/tests/fixtures/fake-cli/codex text eol=lf
plugins/agent-dispatch/tests/fixtures/bin/date text eol=lf
plugins/agent-dispatch/tests/fixtures/bin/sleep text eol=lf
